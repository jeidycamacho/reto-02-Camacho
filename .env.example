# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Modelo de lenguaje por defecto (ej. gemini-3.8-flash)
LLM_MODEL="gemini-3.8-flash"

# Límites de ciclo del agente
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=60000

# Clave de acceso opcional para la API (cabecera x-access-key). Si está vacía, no se exige autenticación.
ACCESS_KEY=""

# Permitir reinicio del directorio out/ mediante POST /api/reset (true/false)
ALLOW_RESET=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
